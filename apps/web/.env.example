# Use a local development database. Never point automated tests at production.
DATABASE_URL=postgresql://fendor:fendor_local_only@localhost:5433/fendor
APP_ORIGIN=http://localhost:3000
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OUTBOX_KEY=
# SMTP email delivery remains optional for local inbox testing; required for real users.
SMTP_URL=
MAIL_FROM=

# Private review only. Auto-verifies new accounts and enables simulated payments.
# Remove or set false before any public beta or real payment collection.
BETA_REVIEW_MODE=false
# Optional shared gate for a publicly reachable private-review deployment.
# Configure only in the hosting provider; never commit the real value.
REVIEW_ACCESS_CODE=

# Required to reserve stock; choose approved Fendor policy (integer 1–1440 minutes).
RESERVATION_MINUTES=
# Vendor availability-response deadline in minutes (integer 1–1440).
VENDOR_RESPONSE_MINUTES=

# Hosted online checkout. Add only test keys locally; configure live keys in the host.
# Independent release switch. Keep false until Fendora approves public checkout.
PUBLIC_CHECKOUT_ENABLED=false
# Never enable sandbox payments on a public beta. This switch exists only for a
# protected production-like test deployment using provider test credentials.
ALLOW_SANDBOX_PAYMENTS=false
PAYSTACK_SECRET_KEY=
# Current Paystack webhook signing secret (`whsec_...`). Configure separately for test and live deployments.
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_ORIGIN=https://api-m.sandbox.paypal.com
# PayPal does not settle the NGN quote directly. Set an approved checkout currency and locked NGN-per-unit rate.
PAYPAL_CURRENCY=USD
PAYPAL_NGN_PER_UNIT=
PAYPAL_WEBHOOK_ID=
