# Copy to .env.staging and replace every CHANGE_ME value before starting staging.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://fendor:CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD@db:5432/fendor
APP_ORIGIN=https://CHANGE_ME.example.com
OUTBOX_KEY=CHANGE_ME_64_HEXADECIMAL_CHARACTERS
RESERVATION_MINUTES=60
VENDOR_RESPONSE_MINUTES=30
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=Fendor Staging <no-reply@CHANGE_ME.example.com>
PAYMENT_BANK_NAME=CHANGE_ME_BANK_NAME
PAYMENT_ACCOUNT_NAME=CHANGE_ME_ACCOUNT_NAME
PAYMENT_ACCOUNT_NUMBER=CHANGE_ME_ACCOUNT_NUMBER
# Hosted payment provider test credentials for staging. Never commit live secrets.
PUBLIC_CHECKOUT_ENABLED=false
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_ORIGIN=https://api-m.sandbox.paypal.com
# Lock and document the approved NGN-per-unit conversion used for each PayPal quote.
PAYPAL_CURRENCY=USD
PAYPAL_NGN_PER_UNIT=
PAYPAL_WEBHOOK_ID=
# Private team review only. Must be false before public beta.
BETA_REVIEW_MODE=false
